# ===== UAVSA-v1.0 环境变量样例 =====
# 复制本文件为 .env 后按需填写：copy .env.example .env
# .env 已被 .gitignore 排除，请勿提交到仓库。

# ---- LLM（默认 DeepSeek，OpenAI 兼容协议） ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# 单次纠偏允许的最大补丁轮次
LLM_MAX_ITERATIONS=5
# 温度：纠偏分析建议 0.1~0.3
LLM_TEMPERATURE=0.2

# ---- Agent ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ---- sim_bridge（docker1） ----
SIM_BRIDGE_PORT=8001
# 默认仿真场景：x500 四旋翼 + 默认世界
SIM_MODEL=gz_x500
SIM_WORLD=default
SIM_HEADLESS=1

# ---- algo_bridge（docker2） ----
ALGO_BRIDGE_PORT=8002

# ---- 共享卷宿主机路径 ----
# 相对路径按仓库根解析（统一到 UAVSA-v1.0/shared），也可填绝对路径
SHARED_DIR=./shared

# ---- 仿真/算法后端开关 ----
# PX4 未编译 / ROS 桥接未就绪前用 Mock 跑通流程；就绪后改为 0 走真实 Gazebo + EGO-Planner
SIM_MOCK=1
ALGO_MOCK=1

# ---- 集群 SSH 模式（--cluster） ----
# 留空表示不使用集群模式。填入你自己的登录信息后再运行 python -m agent.main --cluster
CLUSTER_SSH_HOST=
CLUSTER_SSH_PORT=22
CLUSTER_SSH_USER=
CLUSTER_SSH_PASSWORD=
# 登录后进入的计算节点名（堡垒机菜单里选择）
CLUSTER_SSH_NODE=

# /host 挂载对应的宿主机目录绝对路径（容器内 /host -> 宿主机 <PRP>/docker）
CLUSTER_PRP_DOCKER=

# 容器名（按需修改）
CLUSTER_SIM_CONTAINER=uavsa-sim22
CLUSTER_EGO_CONTAINER=uavsa-ego4
